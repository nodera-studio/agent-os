export interface ContributionStat {
  label: string;
  value: string;
}

export const contributionStats: ContributionStat[] = [
  { value: "9B", label: "Lifetime events" },
  { value: "562.7M", label: "Peak requests" },
  { value: "12h 54m", label: "Longest task" },
  { value: "62 days", label: "Top streak" },
];

export const CONTRIBUTION_WEEKS = 53;
export const CONTRIBUTION_DAYS = 7;

/** A stable year-sized sequence of intensity levels from 0 (empty) to 4 (highest). */
export const contributionValues: number[] = Array.from(
  { length: CONTRIBUTION_WEEKS * CONTRIBUTION_DAYS },
  (_, index) => {
    const week = Math.floor(index / CONTRIBUTION_DAYS);
    const day = index % CONTRIBUTION_DAYS;
    const seed = (week + 1) * 37 + (day + 3) * 17 + week * day * 13;
    const score = (seed * seed + seed * 11 + day * 7) % 29;

    if (score < 5) return 0;
    if (score < 11) return 1;
    if (score < 18) return 2;
    if (score < 24) return 3;
    return 4;
  },
);


