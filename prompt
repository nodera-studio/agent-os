import { useMemo, useState } from "react";

import { ContributionsPanel } from "@/components/dashboard/contributions-panel";
import { EarningsPanel } from "@/components/dashboard/earnings-panel";
import { KpiGrid } from "@/components/dashboard/kpi-grid";
import { RecentHiresPanel } from "@/components/dashboard/recent-hires-panel";
import { RevenuePanel } from "@/components/dashboard/revenue-panel";
import { periodScale, type DashboardPeriod } from "@/components/dashboard/dashboard-config";
import { earnedData, recentHires, revenueData } from "@/data/dashboard";

export function DashboardOverview({ onFeedback }: { onFeedback: (message: string) => void }) {
  const [hireOffset, setHireOffset] = useState(0);
  const [earnedPeriod, setEarnedPeriod] = useState<DashboardPeriod>("weekly");
  const [revenuePeriod, setRevenuePeriod] = useState<DashboardPeriod>("weekly");
  const [activityPeriod, setActivityPeriod] = useState<DashboardPeriod>("weekly");

  const displayedHires = useMemo(
    () => recentHires.map((_, index) => recentHires[(index + hireOffset) % recentHires.length]),
    [hireOffset],
  );

  const scaledEarnedData = useMemo(
    () => earnedData.map((entry) => ({ ...entry, earned: Math.round(entry.earned * periodScale[earnedPeriod]) })),
    [earnedPeriod],
  );

  const scaledRevenueData = useMemo(
    () => revenueData.map((entry) => ({ ...entry, revenue: Math.round(entry.revenue * periodScale[revenuePeriod]) })),
    [revenuePeriod],
  );

  return (
    <>
      <section className="top-grid" aria-label="Overview">
        <RecentHiresPanel
          hires={displayedHires}
          rotationKey={hireOffset}
          onPrevious={() => setHireOffset((offset) => (offset + recentHires.length - 2) % recentHires.length)}
          onNext={() => setHireOffset((offset) => (offset + 2) % recentHires.length)}
          onTeamChange={(team) => onFeedback(`${team} selected`)}
        />
        <EarningsPanel period={earnedPeriod} data={scaledEarnedData} onPeriodChange={setEarnedPeriod} />
      </section>

      <section className="secondary-grid" aria-label="Analytics">
        <RevenuePanel period={revenuePeriod} data={scaledRevenueData} onPeriodChange={setRevenuePeriod} />
        <ContributionsPanel period={activityPeriod} onPeriodChange={setActivityPeriod} />
      </section>

      <KpiGrid />
    </>
  );
}


