import { Chip } from "@/components/base/badges/chip";
import { StatusDot } from "@/components/base/badges/status-dot";
import { IconButton } from "@/components/base/buttons/icon-button";
import { Checkbox } from "@/components/base/checkbox/checkbox";
import {
  Dropdown,
  DropdownGroup,
  DropdownItem,
  DropdownPopover,
  DropdownTrigger,
} from "@/components/base/dropdown/dropdown";
import { Select, SelectItem } from "@/components/base/select/select";
import { parsePrice, PURCHASE_OPTIONS, type PurchaseStatus } from "@/components/dashboard/results-table-config";
import type { Customer } from "@/data/dashboard";
import { cx } from "@/utils/cx";

function purchaseDotColor(status: PurchaseStatus) {
  if (status === "Completed") return "green" as const;
  if (status === "Processing") return "indigo" as const;
  return "yellow" as const;
}

function deliveryChipColor(status: Customer["status"]) {
  if (status === "Shipped") return "lime" as const;
  if (status === "Delivery failed") return "rose" as const;
  if (status === "Delivery waiting") return "yellow" as const;
  return "cyan" as const;
}

function PurchaseSelect({ customer, onChange }: { customer: Customer; onChange: (status: PurchaseStatus) => void }) {
  return (
    <Select
      aria-label={`Purchase status for ${customer.name}`}
      selectedKey={customer.purchase}
      onSelectionChange={(key) => {
        if (key !== null) onChange(String(key) as PurchaseStatus);
      }}
      className="w-[142px]"
      popoverClassName="min-w-[180px]"
    >
      {PURCHASE_OPTIONS.map((status) => (
        <SelectItem key={status} id={status} textValue={status}>
          <StatusDot color={purchaseDotColor(status)} />
          {status}
        </SelectItem>
      ))}
    </Select>
  );
}

export function SortChevron({ direction }: { direction: false | "asc" | "desc" }) {
  return (
    <ArrowDown2
      className={cx(
        "size-6 shrink-0 transition-[transform,color] duration-150",
        direction === "asc" && "rotate-180",
        direction ? "text-text-secondary" : "text-text-tertiary",
      )}
    />
  );
}

function RowActionMenu({
  customer,
  onDuplicate,
  onComplete,
  onDelete,
}: {
  customer: Customer;
  onDuplicate: () => void;
  onComplete: () => void;
  onDelete: () => void;
}) {
  const [isOpen, setIsOpen] = useState(false);
  const runAction = (action: () => void) => {
    action();
    setIsOpen(false);
  };

  return (
    <Dropdown isOpen={isOpen} onOpenChange={setIsOpen}>
      <DropdownTrigger
        aria-label={`More actions for ${customer.name}`}
        className={cx(
          "relative inline-flex size-8 shrink-0 items-center justify-center rounded-2lg",
          "border border-border-button-default bg-background-primary-default text-foreground-icon-primary shadow-xs",
          "transition-[background-color,border-color,box-shadow,color] duration-150 ease",
          "hover:border-border-button-hover hover:bg-background-primary-hover",
          isOpen && "border-border-button-active bg-background-primary-active",
        )}
      >
        <More className="size-4 shrink-0" aria-hidden />
      </DropdownTrigger>
      <DropdownPopover aria-label={`More actions for ${customer.name}`} placement="bottom end" className="w-[224px] p-2">
        <DropdownGroup>
          <DropdownItem
            onSelect={() => runAction(onComplete)}
            selected={customer.purchase === "Completed"}
            className="px-2 py-1.5"
          >
            <StatusDot color="green" />
            <span className="truncate whitespace-nowrap text-body-medium text-text-primary">Mark completed</span>
          </DropdownItem>
          <DropdownItem onSelect={() => runAction(onDuplicate)} className="px-2 py-1.5">
            <Copy className="size-[18px] shrink-0 text-foreground-icon-secondary" aria-hidden />
            <span className="truncate whitespace-nowrap text-body-medium text-text-primary">Duplicate customer</span>
          </DropdownItem>
          <DropdownItem onSelect={() => runAction(onDelete)} className="px-2 py-1.5 text-text-error-primary">
            <Trash className="size-[18px] shrink-0" aria-hidden />
            <span className="truncate whitespace-nowrap text-body-medium">Delete customer</span>
          </DropdownItem>
        </DropdownGroup>
      </DropdownPopover>
    </Dropdown>
  );
}

export function createCustomerColumns({
  updatePurchase,
  cyclePurchase,
  deleteCustomer,
  duplicateCustomer,
}: {
  updatePurchase: (id: Customer["id"], purchase: PurchaseStatus) => void;
  cyclePurchase: (customer: Customer) => void;
  deleteCustomer: (id: Customer["id"]) => void;
  duplicateCustomer: (customer: Customer) => void;
}): ColumnDef<Customer>[] {
  return [
    {
      accessorKey: "name",
      header: "Customer name",
      cell: ({ row }) => {
        const customer = row.original;
        return (
          <div className="flex min-w-0 items-center gap-2">
            <Checkbox slot={null} aria-label={`Select ${customer.name}`} isSelected={row.getIsSelected()} onChange={(selected) => row.toggleSelected(Boolean(selected))} />
            <Avatar size="sm" src={customer.avatar} alt="" initials={customer.initials} color={Number(customer.id) % 2 === 0 ? "blue" : "neutral"} />
            <span className="truncate text-body-medium text-text-primary">{customer.name}</span>
          </div>
        );
      },
    },
    {
      accessorKey: "purchase",
      header: "Purchase",
      cell: ({ row }) => <PurchaseSelect customer={row.original} onChange={(purchase) => updatePurchase(row.original.id, purchase)} />,
    },
    {
      accessorKey: "status",
      header: "Status",
      cell: ({ row }) => <Chip color={deliveryChipColor(row.original.status)}>{row.original.status}</Chip>,
    },
    {
      id: "lastUpdated",
      accessorFn: (customer) => Date.parse(customer.lastUpdated) || 0,
      header: "Last updated",
      cell: ({ row }) => <span className="whitespace-nowrap text-body-medium text-text-primary">{row.original.lastUpdated}</span>,
    },
    {
      id: "price",
      accessorFn: (customer) => parsePrice(customer.price),
      header: "Price",
      cell: ({ row }) => <Chip variant="subtle" color="gray">{row.original.price}</Chip>,
    },
    {
      id: "actions",
      header: "Actions",
      enableSorting: false,
      cell: ({ row }) => {
        const customer = row.original;
        return (
          <div className="flex items-center justify-end gap-2.5">
            <IconButton icon={Trash} size="small" aria-label={`Delete ${customer.name}`} onClick={() => deleteCustomer(customer.id)} />
            <IconButton icon={Edit2} size="small" aria-label={`Advance purchase status for ${customer.name}`} onClick={() => cyclePurchase(customer)} />
            <RowActionMenu
              customer={customer}
              onComplete={() => updatePurchase(customer.id, "Completed")}
              onDuplicate={() => duplicateCustomer(customer)}
              onDelete={() => deleteCustomer(customer.id)}
            />
          </div>
        );
      },
    },
  ];
}


// src/components/dashboard/contribution-grid.tsx
"use client";

import { useRef, useState } from "react";
import type { HTMLAttributes, KeyboardEvent } from "react";
import { contributionValues } from "@/data/dashboard";
import { cx } from "@/utils/cx";

const COLUMN_COUNT = 53;
const ROW_COUNT = 7;
const CELL_COUNT = COLUMN_COUNT * ROW_COUNT;
const DAY_IN_MS = 24 * 60 * 60 * 1000;

const MONTHS = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
] as const;

/** Stable 53-week demo dataset, kept as a named export for standalone use. */
export const CONTRIBUTION_VALUES: number[] = contributionValues;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

function getGridStart(year: number) {
  const firstDay = new Date(Date.UTC(year, 0, 1));
  firstDay.setUTCDate(firstDay.getUTCDate() - firstDay.getUTCDay());
  return firstDay;
}

function getIntensity(value: number) {
  return Math.min(4, Math.max(0, Math.round(value)));
}

function getCellLabel(value: number, date: Date) {
  const contributionLabel = value === 1 ? "contribution" : "contributions";
  return `${value} ${contributionLabel} on ${dateFormatter.format(date)}`;
}

export interface ContributionGridProps
  extends Omit<HTMLAttributes<HTMLElement>, "aria-label" | "children"> {
  /** Exactly 371 values, ordered by week first and weekday second. */
  values?: readonly number[];
  /** Calendar year represented by the Jan–Dec labels. */
  year?: number;
  /** Accessible name for the heatmap region. */
  ariaLabel?: string;
}

/**
 * A GitHub-style, column-major contribution heatmap.
 *
 * Only one cell participates in the tab order. Once focused, arrow keys move
 * by day or week; Home and End jump to the first/last day of the current week.
 */
export function ContributionGrid({
  values = CONTRIBUTION_VALUES,
  year = 2026,
  ariaLabel,
  className,
  ...props
}: ContributionGridProps) {
  const [activeIndex, setActiveIndex] = useState(0);
  const cellRefs = useRef<Array<HTMLButtonElement | null>>([]);
  const gridStart = getGridStart(year);
  const normalizedValues = Array.from({ length: CELL_COUNT }, (_, index) => {
    const value = values[index];
    return Number.isFinite(value) ? Math.max(0, Math.round(value)) : 0;
  });

  const monthColumns = MONTHS.map((_, month) =>
    Math.min(
      COLUMN_COUNT - 1,
      Math.max(
        0,
        Math.floor((Date.UTC(year, month, 1) - gridStart.getTime()) / (DAY_IN_MS * ROW_COUNT)),
      ),
    ),
  );

  function focusCell(index: number) {
    const nextIndex = Math.min(CELL_COUNT - 1, Math.max(0, index));
    setActiveIndex(nextIndex);
    cellRefs.current[nextIndex]?.focus();
  }

  function handleKeyDown(event: KeyboardEvent<HTMLButtonElement>, index: number) {
    const column = Math.floor(index / ROW_COUNT);
    const row = index % ROW_COUNT;
    let nextIndex = index;

    switch (event.key) {
      case "ArrowLeft":
        if (column > 0) nextIndex = index - ROW_COUNT;
        break;
      case "ArrowRight":
        if (column < COLUMN_COUNT - 1) nextIndex = index + ROW_COUNT;
        break;
      case "ArrowUp":
        if (row > 0) nextIndex = index - 1;
        break;
      case "ArrowDown":
        if (row < ROW_COUNT - 1) nextIndex = index + 1;
        break;
      case "Home":
        nextIndex = event.ctrlKey || event.metaKey ? 0 : index - row;
        break;
      case "End":
        nextIndex =
          event.ctrlKey || event.metaKey
            ? CELL_COUNT - 1
            : index + (ROW_COUNT - 1 - row);
        break;
      default:
        return;
    }

    event.preventDefault();
    focusCell(nextIndex);
  }

  return (
    <section
      aria-label={ariaLabel ?? `Contribution activity for ${year}`}
      className={cx("min-w-0", className)}
      {...props}
    >
      <p className="sr-only">
        Contribution calendar with {COLUMN_COUNT} weeks. Use the arrow keys to
        explore individual days.
      </p>

      <div
        className={cx(
          "overflow-x-auto overscroll-x-contain pb-1",
          "[scrollbar-color:var(--color-chart-cursor)_transparent] [scrollbar-width:thin]",
        )}
      >
        <div className="min-w-[680px]">
          <div
            className="grid gap-[3px]"
            style={{ gridTemplateColumns: `repeat(${COLUMN_COUNT}, minmax(0, 1fr))` }}
          >
            {Array.from({ length: COLUMN_COUNT }, (_, column) => (
              <div key={column} className="grid min-w-0 grid-rows-7 gap-[3px]">
                {Array.from({ length: ROW_COUNT }, (_, row) => {
                  const index = column * ROW_COUNT + row;
                  const value = normalizedValues[index];
                  const date = new Date(gridStart.getTime() + index * DAY_IN_MS);
                  const label = getCellLabel(value, date);
                  const intensity = getIntensity(value);

                  return (
                    <button
                      key={index}
                      ref={(node) => {
                        cellRefs.current[index] = node;
                      }}
                      type="button"
                      aria-label={label}
                      title={label}
                      tabIndex={index === activeIndex ? 0 : -1}
                      data-column={column + 1}
                      data-row={row + 1}
                      data-value={value}
                      data-intensity={intensity}
                      className={cx(
                        "contribution-cell",
                        "aspect-square min-w-0 rounded-[3px] border-0 p-0",
                        "outline-none ring-offset-1 ring-offset-background-primary-default",
                        "transition-[background-color,scale] duration-100 ease-out",
                        "hover:relative hover:z-10 hover:scale-110",
                        "focus-visible:relative focus-visible:z-10 focus-visible:scale-110 focus-visible:ring-2 focus-visible:ring-border-focus-ring",
                        "motion-reduce:transition-none",
                      )}
                      onFocus={() => setActiveIndex(index)}
                      onKeyDown={(event) => handleKeyDown(event, index)}
                    >
                      <span className="sr-only">{label}</span>
                    </button>
                  );
                })}
              </div>
            ))}
          </div>

          <div
            aria-hidden="true"
            className="mt-2 grid gap-[3px] text-caption-1-regular text-text-tertiary"
            style={{ gridTemplateColumns: `repeat(${COLUMN_COUNT}, minmax(0, 1fr))` }}
          >
            {MONTHS.map((month, index) => {
              const startColumn = monthColumns[index];
              const nextColumn = monthColumns[index + 1] ?? COLUMN_COUNT;

              return (
                <span
                  key={month}
                  className="min-w-0 whitespace-nowrap"
                  style={{
                    gridColumn: `${startColumn + 1} / span ${Math.max(1, nextColumn - startColumn)}`,
                  }}
                >
                  {month}
                </span>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  );
}

export default ContributionGrid;


// src/components/dashboard/dashboard-controls.tsx
import { SegmentedControl, SegmentedControlItem } from "@/components/base/segmented-control/segmented-control";
import type { DashboardPeriod } from "@/components/dashboard/dashboard-config";
import { cx } from "@/utils/cx";

export function PeriodControl({
  value,
  onChange,
  label,
}: {
  value: DashboardPeriod;
  onChange: (period: DashboardPeriod) => void;
  label: string;
}) {
  return (
    <SegmentedControl
      aria-label={label}
      className="period-control"
      selectedKeys={[value]}
      onSelectionChange={(keys) => {
        const next = Array.from(keys)[0];
        if (next === "weekly" || next === "monthly" || next === "yearly") {
          onChange(next);
        }
      }}
    >
      <SegmentedControlItem id="weekly">Weekly</SegmentedControlItem>
      <SegmentedControlItem id="monthly">Monthly</SegmentedControlItem>
      <SegmentedControlItem id="yearly">Yearly</SegmentedControlItem>
    </SegmentedControl>
  );
}

export function GrowthBadge({
  children,
  trend = "up",
}: {
  children: string;
  trend?: "up" | "down" | "flat";
}) {
  return (
    <span
      className={cx(
        "growth-badge",
        trend === "down" && "negative-badge",
        trend === "flat" && "neutral-badge",
      )}
    >
      {children}
    </span>
  );
}


// src/components/base/buttons/icon-button.tsx
import type {
  AnchorHTMLAttributes,
  ButtonHTMLAttributes,
  ComponentType,
  Ref,
} from "react";
import { cx, sortCx } from "@/utils/cx";

/**
 * Figma source: Board UI → dashboard 1 icon-only buttons (notification button
 * node 3731:3035, table row actions nodes 3731:3284/3287/3290).
 *
 * Square icon-only button. Unlike `Button` (whose small size is radius/lg with
 * an 18px icon), the icon button keeps radius/2lg (10px) at both sizes:
 *
 *            container   padding   icon
 *   medium   36×36       8         20×20
 *   small    32×32       8         16×16
 *
 * One variant in the designs: secondary (white fill, border/button/default,
 * shadow/xs). Hover/active/disabled states reuse the secondary Button tokens.
 */

type IconButtonSize = "medium" | "small";

type IconComponent = ComponentType<{
  className?: string;
  "aria-hidden"?: boolean | "true" | "false";
}>;

export interface IconButtonProps
  extends Omit<ButtonHTMLAttributes<HTMLButtonElement>, "children"> {
  icon: IconComponent;
  size?: IconButtonSize;
  /** Accessible name — required since there is no visible label. */
  "aria-label": string;
  ref?: Ref<HTMLButtonElement>;
}

export interface IconLinkButtonProps
  extends Omit<AnchorHTMLAttributes<HTMLAnchorElement>, "children"> {
  icon: IconComponent;
  size?: IconButtonSize;
  /** Accessible name — required since there is no visible label. */
  "aria-label": string;
  ref?: Ref<HTMLAnchorElement>;
}

const styles = sortCx({
  base: [
    "relative inline-flex shrink-0 items-center justify-center overflow-visible rounded-2lg",
    "bg-background-primary-default text-foreground-icon-primary",
    "border border-border-button-default shadow-xs",
    "select-none cursor-pointer",
    "transition-[background-color,border-color,box-shadow,color] duration-150 ease",
    "outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-border-focus-ring",
    "hover:bg-background-primary-hover hover:border-border-button-hover",
    "active:bg-background-primary-active active:border-border-button-active",
    "disabled:cursor-not-allowed disabled:bg-background-primary-disabled disabled:border-border-button-default disabled:text-icon-button-disabled-foreground disabled:opacity-60 disabled:shadow-none",
  ].join(" "),
  size: {
    medium: "size-9",
    small: "size-8",
  },
  icon: {
    medium: "size-5 shrink-0",
    small: "size-4 shrink-0",
  },
});

export function IconButton({
  icon: Icon,
  size = "medium",
  className,
  type = "button",
  ref,
  ...props
}: IconButtonProps) {
  return (
    <button
      ref={ref}
      type={type}
      className={cx(styles.base, styles.size[size], className)}
      {...props}
    >
      <Icon className={styles.icon[size]} aria-hidden />
    </button>
  );
}

/** Anchor counterpart to IconButton for external and navigational actions. */
export function IconLinkButton({
  icon: Icon,
  size = "medium",
  className,
  ref,
  ...props
}: IconLinkButtonProps) {
  return (
    <a
      ref={ref}
      className={cx(styles.base, styles.size[size], className)}
      {...props}
    >
      <Icon className={styles.icon[size]} aria-hidden />
    </a>
  );
}


// src/components/base/buttons/close-button.tsx
import type { ButtonHTMLAttributes, Ref } from "react";
import { cx, sortCx } from "@/utils/cx";

/**
 * Compact circular dismiss control — the "X" used to close announcements,
 * toasts, modals, and drawers. Companion to `IconButton`, but ships its own
 * glyph (rather than taking an `icon` prop) so every consumer gets an
 * identical X with a stroke that's a true CSS pixel value per size, not a
 * scaled approximation.
 *
 * The glyph is a hand-drawn SVG per size (not a shared icon scaled up/down)
 * because scaling a single glyph across sizes scales its stroke too — a 2px
 * line at 20px becomes ~3.2px at 32px. Each size below renders its own X in a
 * viewBox equal to its own pixel dimensions, so `strokeWidth` is always a
 * literal CSS pixel value, at every size (not a scaled approximation).
 *
 * Sizes (px):
 *   2xs = 16 container, 6.8px glyph, 1.6px stroke   (compact floating surfaces)
 *   xs = 20 container, 10.8px glyph, 2px stroke     (Announcement dismiss corner)
 *   sm = 24 container, 12.6px glyph, 2px stroke
 *   md = 32 container, 16.2px glyph, 2.5px stroke   (modal header close — a touch
 *                                                     bolder to hold its own at
 *                                                     the larger size)
 *
 * Glyph sizes are 90% of the container's natural proportion (12/14/18 → the
 * above), tuned down 10% across the board so the X reads a touch smaller
 * inside its circle.
 */

type CloseButtonSize = "2xs" | "xs" | "sm" | "md";

export interface CloseButtonProps
  extends Omit<ButtonHTMLAttributes<HTMLButtonElement>, "children"> {
  size?: CloseButtonSize;
  /** Accessible name — required since there is no visible label. */
  "aria-label": string;
  ref?: Ref<HTMLButtonElement>;
}

const GLYPH_SIZE: Record<CloseButtonSize, number> = {
  "2xs": 6.8,
  xs: 10.8,
  sm: 12.6,
  md: 16.2,
};

const STROKE_WIDTH: Record<CloseButtonSize, number> = {
  "2xs": 1.6,
  xs: 2,
  sm: 2,
  md: 2.5,
};

const GLYPH_INSET: Record<CloseButtonSize, number> = {
  // Figma's 8px bars rotate inside a 6.8px square, leaving ~0.57px at
  // each corner once projected onto the diagonal.
  "2xs": 0.57,
  xs: 2,
  sm: 2,
  md: 2,
};

const styles = sortCx({
  base: [
    "inline-flex shrink-0 items-center justify-center rounded-full",
    "bg-background-tertiary-default text-foreground-icon-secondary",
    "select-none cursor-pointer",
    "transition-colors duration-150 ease",
    "hover:text-text-primary",
    "outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-border-focus-ring",
  ].join(" "),
  container: {
    "2xs": "size-4",
    xs: "size-5",
    sm: "size-6",
    md: "size-8",
  },
});

export function CloseButton({
  size = "xs",
  className,
  type = "button",
  ref,
  ...props
}: CloseButtonProps) {
  const glyph = GLYPH_SIZE[size];
  const strokeWidth = STROKE_WIDTH[size];
  const inset = GLYPH_INSET[size];

  return (
    <button
      ref={ref}
      type={type}
      className={cx(styles.base, styles.container[size], className)}
      {...props}
    >
      <svg width={glyph} height={glyph} viewBox={`0 0 ${glyph} ${glyph}`} fill="none" aria-hidden>
        <path
          d={`M${inset} ${inset}L${glyph - inset} ${glyph - inset}`}
          stroke="currentColor"
          strokeWidth={strokeWidth}
          strokeLinecap="round"
        />
        <path
          d={`M${glyph - inset} ${inset}L${inset} ${glyph - inset}`}
          stroke="currentColor"
          strokeWidth={strokeWidth}
          strokeLinecap="round"
        />
      </svg>
    </button>
  );
}


// src/components/base/buttons/button.tsx
import type {
  AnchorHTMLAttributes,
  ButtonHTMLAttributes,
  ComponentType,
  ReactNode,
  Ref,
} from "react";
import { cx, sortCx } from "@/utils/cx";

/**
 * Figma source: Board UI → Buttons (node 3656:13819).
 *
 * Variant matrix from Figma:
 *   Type     = Primary | Secondary | Ghost | Danger
 *   Size     = Medium  | Small | Xs
 *   State    = Default | Hover | Active | Disabled        (CSS pseudo)
 *   OnlyIcon = false   | true
 *
 * Sizing (1:1 with Figma):
 *
 *                       Medium                    Small                     Xs
 *   container          h=36, p=8,   r=10         h=32, px=8 py=6, r=8      h=24, px=8, r=4
 *   gap                 2px                       2px                      1.33px→1
 *   icon                20×20                     18×18                    14×14
 *   label wrapper       px=4                      px=2                     px=2
 *   text style          Body 1/Medium             Body 1/Medium            Caption 1/Semibold
 *   icon-only square    36×36 (content-derived)   32×32 (forced size)      24×24 (forced size)
 *
 * `xs` is the smallest tier — first needed for the calendar template's
 * event-details modal ("Join" / edit-icon buttons, node 3920:10954), which
 * scales every dimension down by the same ~0.667 factor from Figma; the
 * table above rounds those to clean pixel values rather than reproducing
 * the fractional source numbers.
 *
 * Icons are rendered by the component itself via the `leadingIcon` /
 * `trailingIcon` props so the consumer can't pass the wrong size. Pass
 * an icon component reference (`Add`, not `<Add />`).
 *
 * For icon-only buttons:
 *   <Button iconOnly leadingIcon={Add} aria-label="Add" />
 *
 * The HTML `type` prop is preserved; Figma's "Type" enum is renamed to
 * `variant` to avoid the clash.
 */

type ButtonVariant = "primary" | "secondary" | "ghost" | "danger";
type ButtonSize = "medium" | "small" | "xs";

type IconComponent = ComponentType<{
  className?: string;
  "aria-hidden"?: boolean | "true" | "false";
}>;

export interface ButtonProps
  extends Omit<ButtonHTMLAttributes<HTMLButtonElement>, "children"> {
  variant?: ButtonVariant;
  size?: ButtonSize;
  iconOnly?: boolean;
  leadingIcon?: IconComponent;
  trailingIcon?: IconComponent;
  children?: ReactNode;
  ref?: Ref<HTMLButtonElement>;
}

export interface ButtonLinkProps
  extends Omit<AnchorHTMLAttributes<HTMLAnchorElement>, "children"> {
  variant?: ButtonVariant;
  size?: ButtonSize;
  iconOnly?: boolean;
  leadingIcon?: IconComponent;
  trailingIcon?: IconComponent;
  children?: ReactNode;
  ref?: Ref<HTMLAnchorElement>;
}

const styles = sortCx({
  base: [
    "inline-flex items-center justify-center gap-0.5 whitespace-nowrap overflow-hidden",
    "font-sans select-none cursor-pointer",
    "button-press-motion",
    "outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-border-focus-ring",
    "disabled:cursor-not-allowed aria-disabled:cursor-not-allowed",
  ].join(" "),

  // Base shape per size (used when label is present OR medium icon-only).
  size: {
    medium: "h-9 rounded-2lg p-2 text-body-medium",
    small:  "h-8 rounded-lg px-2 py-1.5 text-body-medium",
    xs:     "h-6 rounded-sm px-2 text-caption-1-semibold",
