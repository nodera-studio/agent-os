:root {
  --font-inter: "Geist Variable";
  --dashboard-gap: 16px;
  --dashboard-radius: 16px;
  --dashboard-track: var(--color-chart-track);
}

html,
body,
#root {
  min-height: 100%;
}

body {
  margin: 0;
  overflow-x: hidden;
}

* {
  box-sizing: border-box;
}

button,
a,
input,
textarea {
  -webkit-tap-highlight-color: transparent;
}

.dashboard-shell {
  min-height: 100vh;
  background: var(--color-background-full);
}

.sidebar-rail {
  position: fixed;
  inset-block: 12px;
  left: 12px;
  z-index: 30;
  width: 260px;
  height: calc(100vh - 24px);
  transition: width 300ms ease-in-out;
}

.dashboard-shell[data-sidebar-collapsed="true"] .sidebar-rail {
  width: 60px;
}

.dashboard-main {
  min-width: 0;
  margin-left: 284px;
  padding: 24px 12px 48px;
  transition: margin-left 300ms ease-in-out;
}

.dashboard-shell[data-sidebar-collapsed="true"] .dashboard-main {
  margin-left: 84px;
}

.dashboard-canvas {
  width: min(100%, 1300px);
  margin-inline: auto;
}

.dashboard-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 10px;
}

.dashboard-heading-row {
  display: flex;
  min-height: 36px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.dashboard-heading-group {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10px;
}

.dashboard-title {
  margin: 0;
  color: var(--color-text-primary);
  font-size: 20px;
  font-weight: 500;
  line-height: 26px;
  letter-spacing: -0.02em;
}

.dashboard-actions {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}

.mobile-nav-trigger {
  display: none;
}

.notification-wrap {
  position: relative;
}

.notification-trigger {
  position: relative;
  display: grid;
  width: 36px;
  height: 36px;
  place-items: center;
  border: 1px solid var(--color-border-button-default);
  border-radius: 12px;
  background: var(--color-background-primary-default);
  color: var(--color-foreground-icon-primary);
  box-shadow: var(--shadow-xs);
  transition: border-color 160ms ease, background-color 160ms ease;
