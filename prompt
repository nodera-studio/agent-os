import { useEffect, useState } from "react";
import { TickCircle } from "iconsax-reactjs";

import { DashboardSidebar } from "@/components/application/dashboard/dashboard-sidebar";
import { DashboardHeader } from "@/components/dashboard/dashboard-header";
import { DashboardOverview } from "@/components/dashboard/dashboard-overview";
import { ResultsTable } from "@/components/dashboard/results-table";
import { TicketDialog } from "@/components/dashboard/ticket-dialog";
import "@/styles/dashboard.css";

export default function App() {
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [mobileSidebarOpen, setMobileSidebarOpen] = useState(false);
  const [ticketOpen, setTicketOpen] = useState(false);
  const [toast, setToast] = useState<string | null>(null);

  useEffect(() => {
    if (!toast) return;
    const timeout = window.setTimeout(() => setToast(null), 2_800);
    return () => window.clearTimeout(timeout);
  }, [toast]);

  useEffect(() => {
    const handleKeyDown = (event: KeyboardEvent) => {
      if (event.key !== "Escape") return;
      setTicketOpen(false);
      setMobileSidebarOpen(false);
    };

    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, []);

  const openCustomerFilters = () => {
    document.getElementById("results")?.scrollIntoView({ behavior: "smooth", block: "start" });
    setToast("Customer filters are ready");
  };

  return (
    <div className="dashboard-shell" data-sidebar-collapsed={sidebarCollapsed}>
      <div className="sidebar-rail">
        <DashboardSidebar onCollapsedChange={setSidebarCollapsed} />
      </div>

      {mobileSidebarOpen && (
        <div className="mobile-sidebar-backdrop" onMouseDown={() => setMobileSidebarOpen(false)}>
          <div className="mobile-sidebar-panel" onMouseDown={(event) => event.stopPropagation()}>
            <DashboardSidebar mobile fluid onClose={() => setMobileSidebarOpen(false)} />
          </div>
        </div>
      )}

      <main className="dashboard-main">
        <div className="dashboard-canvas">
          <DashboardHeader
            onOpenNavigation={() => setMobileSidebarOpen(true)}
            onOpenFilters={openCustomerFilters}
            onCreateTicket={() => setTicketOpen(true)}
            onFeedback={setToast}
          />

          <div className="dashboard-section-stack">
            <DashboardOverview onFeedback={setToast} />
            <div id="results" className="results-anchor">
              <ResultsTable />
            </div>
          </div>
        </div>
      </main>

      {ticketOpen && (
        <TicketDialog
          onClose={() => setTicketOpen(false)}
          onCreated={() => {
            setTicketOpen(false);
            setToast("Ticket created successfully");
          }}
        />
      )}

      {toast && (
        <div className="dashboard-toast" role="status">
          <TickCircle aria-hidden />
          {toast}
        </div>
      )}
    </div>
  );
}


