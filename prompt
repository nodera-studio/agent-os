// src/components/dashboard/results-table-config.ts
import type { Customer } from "@/data/dashboard";

export type PurchaseStatus = Customer["purchase"];

export const PAGE_SIZE = 8;

export const PURCHASE_OPTIONS = ["Waiting", "Completed", "Processing"] as const;

export const PRICE_BUCKETS = [
  { id: "all", label: "All prices", includes: () => true },
  { id: "under-100", label: "Under $100", includes: (price: number) => price < 100 },
  {
    id: "100-500",
    label: "$100 – $500",
    includes: (price: number) => price >= 100 && price <= 500,
  },
  {
    id: "500-1000",
    label: "$500 – $1,000",
    includes: (price: number) => price > 500 && price <= 1_000,
  },
  { id: "over-1000", label: "Over $1,000", includes: (price: number) => price > 1_000 },
] as const;

export const COLUMN_WIDTHS: Record<string, string> = {
  name: "w-[240px]",
  purchase: "w-[172px]",
  status: "w-[168px]",
  lastUpdated: "w-[160px]",
  price: "w-[140px]",
  actions: "w-[132px]",
};

export function parsePrice(price: string) {
  const numeric = price.replace(/[^0-9.,-]/g, "");
  const normalized = /^-?\d{1,3}(?:[.,]\d{3})+$/.test(numeric)
    ? numeric.replace(/[.,]/g, "")
    : numeric.replace(/,/g, "");
  const parsed = Number(normalized);
  return Number.isFinite(parsed) ? parsed : 0;
}


// src/components/dashboard/results-table.tsx
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import {
  flexRender,
  getCoreRowModel,
  getPaginationRowModel,
  getSortedRowModel,
  useReactTable,
} from "@tanstack/react-table";
import type { PaginationState, SortingState } from "@tanstack/react-table";

import { Checkbox } from "@/components/base/checkbox/checkbox";
import { Pagination } from "@/components/base/pagination/pagination";
import {
  Table,
  TableBody,
  TableCell,
  TableColumn,
  TableHeader,
  TableRow,
} from "@/components/base/table/table";
import { createCustomerColumns, SortChevron } from "@/components/dashboard/customer-table-columns";
import {
  COLUMN_WIDTHS,
  PAGE_SIZE,
  parsePrice,
  PRICE_BUCKETS,
  PURCHASE_OPTIONS,
  type PurchaseStatus,
} from "@/components/dashboard/results-table-config";
import { ResultsTableToolbar } from "@/components/dashboard/results-table-toolbar";
import { customers, type Customer } from "@/data/dashboard";
import { cx } from "@/utils/cx";

export function ResultsTable() {
  const [rows, setRows] = useState<Customer[]>(() => customers.map((customer) => ({ ...customer })));
  const [sorting, setSorting] = useState<SortingState>([]);
  const [rowSelection, setRowSelection] = useState<Record<string, boolean>>({});
  const [pagination, setPagination] = useState<PaginationState>({
    pageIndex: 0,
    pageSize: PAGE_SIZE,
  });
  const [priceFilter, setPriceFilter] = useState("all");
  const [productFilter, setProductFilter] = useState("all");
  const [regionFilter, setRegionFilter] = useState("all");
  const [query, setQuery] = useState("");

  const products = useMemo(
    () => Array.from(new Set(customers.map((customer) => customer.product))).sort(),
    [],
  );
  const regions = useMemo(
    () => Array.from(new Set(customers.map((customer) => customer.region))).sort(),
    [],
  );

  const resetPage = useCallback(() => {
    setPagination((current) => ({ ...current, pageIndex: 0 }));
  }, []);

  const updatePurchase = useCallback((id: Customer["id"], purchase: PurchaseStatus) => {
    setRows((current) =>
      current.map((customer) => (customer.id === id ? { ...customer, purchase } : customer)),
    );
  }, []);

  const cyclePurchase = useCallback((customer: Customer) => {
    const currentIndex = PURCHASE_OPTIONS.indexOf(customer.purchase as (typeof PURCHASE_OPTIONS)[number]);
    const nextIndex = currentIndex < 0 ? 0 : (currentIndex + 1) % PURCHASE_OPTIONS.length;
    updatePurchase(customer.id, PURCHASE_OPTIONS[nextIndex] as PurchaseStatus);
  }, [updatePurchase]);

  const deleteCustomer = useCallback((id: Customer["id"]) => {
    setRows((current) => current.filter((customer) => customer.id !== id));
    setRowSelection((current) => {
      const next = { ...current };
      delete next[String(id)];
      return next;
    });
  }, []);

  const duplicateCustomer = useCallback((customer: Customer) => {
    setRows((current) => {
      const nextId = current.reduce((largest, row) => Math.max(largest, Number(row.id)), 0) + 1;
      return [
        ...current,
        {
          ...customer,
          id: nextId,
          name: `${customer.name} copy`,
        },
      ];
    });
  }, []);

  const filteredRows = useMemo(() => {
    const priceBucket =
      PRICE_BUCKETS.find((bucket) => bucket.id === priceFilter) ?? PRICE_BUCKETS[0];
    const normalizedQuery = query.trim().toLocaleLowerCase();

    return rows.filter((customer) => {
      const searchable = [
        customer.name,
        customer.product,
        customer.region,
        customer.purchase,
        customer.status,
        customer.price,
      ]
        .join(" ")
        .toLocaleLowerCase();

      return (
        priceBucket.includes(parsePrice(customer.price)) &&
        (productFilter === "all" || customer.product === productFilter) &&
        (regionFilter === "all" || customer.region === regionFilter) &&
        (normalizedQuery === "" || searchable.includes(normalizedQuery))
      );
    });
  }, [priceFilter, productFilter, query, regionFilter, rows]);

  const columns = useMemo(
    () => createCustomerColumns({ updatePurchase, cyclePurchase, deleteCustomer, duplicateCustomer }),
    [cyclePurchase, deleteCustomer, duplicateCustomer, updatePurchase],
  );

  const table = useReactTable({
    data: filteredRows,
    columns,
    getRowId: (customer) => String(customer.id),
    state: { sorting, rowSelection, pagination },
    onSortingChange: setSorting,
    onRowSelectionChange: setRowSelection,
    onPaginationChange: setPagination,
    getCoreRowModel: getCoreRowModel(),
    getSortedRowModel: getSortedRowModel(),
    getPaginationRowModel: getPaginationRowModel(),
    enableRowSelection: true,
  });

  const headers = table.getHeaderGroups()[0].headers;
  const visibleRows = table.getRowModel().rows;
  const totalPages = table.getPageCount();

  useEffect(() => {
    const lastPageIndex = Math.max(0, totalPages - 1);
    if (pagination.pageIndex > lastPageIndex) {
      setPagination((current) => ({ ...current, pageIndex: lastPageIndex }));
    }
  }, [pagination.pageIndex, totalPages]);

  return (
    <section
      aria-label="Customer results"
      className={cx(
        "flex min-w-0 w-full flex-col overflow-hidden rounded-2xl border border-border-table pt-2",
        totalPages > 1 ? "pb-3" : "pb-0",
      )}
    >
      <ResultsTableToolbar
        resultCount={filteredRows.length}
        priceFilter={priceFilter}
        productFilter={productFilter}
        regionFilter={regionFilter}
        query={query}
        products={products}
        regions={regions}
        onPriceFilterChange={(value) => {
          setPriceFilter(value);
          resetPage();
        }}
        onProductFilterChange={(value) => {
          setProductFilter(value);
          resetPage();
        }}
        onRegionFilterChange={(value) => {
          setRegionFilter(value);
          resetPage();
        }}
        onQueryChange={(value) => {
          setQuery(value);
          resetPage();
        }}
      />

      <div className="mt-2">
        <Table aria-label="Customers" selectionMode="none" className="min-w-[1000px]">
          <TableHeader>
            {headers.map((header) => {
              const columnId = header.column.id;
              const canSort = header.column.getCanSort();
              const label = flexRender(header.column.columnDef.header, header.getContext());
              const direction = header.column.getIsSorted();

              return (
                <TableColumn
                  key={header.id}
                  id={header.id}
                  isRowHeader={columnId === "name"}
                  className={COLUMN_WIDTHS[columnId]}
                >
                  {columnId === "name" ? (
                    <div className="flex items-center gap-2">
                      <Checkbox
                        slot={null}
                        aria-label="Select all customers on this page"
                        isSelected={table.getIsAllPageRowsSelected()}
                        isIndeterminate={
                          table.getIsSomePageRowsSelected() && !table.getIsAllPageRowsSelected()
                        }
                        onChange={(selected) =>
                          table.toggleAllPageRowsSelected(Boolean(selected))
                        }
                      />
                      <button
                        type="button"
                        aria-label="Sort by customer name"
                        onClick={header.column.getToggleSortingHandler()}
                        className="flex cursor-pointer items-center gap-0.5 outline-none focus-visible:ring-2 focus-visible:ring-border-focus-ring"
                      >
                        {label}
                        <SortChevron direction={direction} />
                      </button>
                    </div>
                  ) : canSort ? (
                    <button
                      type="button"
                      aria-label={`Sort by ${String(label)}`}
                      onClick={header.column.getToggleSortingHandler()}
                      className="flex cursor-pointer items-center gap-0.5 outline-none focus-visible:ring-2 focus-visible:ring-border-focus-ring"
                    >
                      {label}
                      <SortChevron direction={direction} />
                    </button>
                  ) : (
                    label
                  )}
                </TableColumn>
              );
            })}
          </TableHeader>

          <TableBody
            renderEmptyState={() => (
              <div className="flex h-40 items-center justify-center text-body-medium text-text-tertiary">
                No customers match your filters.
              </div>
            )}
          >
            {visibleRows.map((row) => {
              const selected = row.getIsSelected();
              return (
                <TableRow
                  key={row.id}
                  id={row.id}
                  style={
                    selected
                      ? { backgroundColor: "var(--color-background-secondary-default)" }
                      : undefined
                  }
                >
                  {row.getVisibleCells().map((cell) => (
                    <TableCell key={cell.id} className={COLUMN_WIDTHS[cell.column.id]}>
                      {flexRender(cell.column.columnDef.cell, cell.getContext())}
                    </TableCell>
                  ))}
                </TableRow>
              );
            })}
          </TableBody>
        </Table>
      </div>

      {totalPages > 1 && (
        <div className="px-3 pt-3">
          <Pagination
            page={pagination.pageIndex + 1}
            totalPages={totalPages}
            onChange={(page) => table.setPageIndex(page - 1)}
          />
        </div>
      )}
    </section>
  );
}


