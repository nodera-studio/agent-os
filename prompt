    var(--lg-rim-hi, rgb(255 255 255 / 0.9)) 0deg,
    var(--lg-rim-sh, rgb(0 0 0 / 0.14)) 70deg,
    var(--lg-rim-dim, rgb(255 255 255 / 0.1)) 140deg,
