    const status = pick(STATUSES);
    const purchase: Customer["purchase"] =
      rng() < 0.24
        ? "processing"
        : status.label === "Shipped" || status.label === "Confirmed"
          ? "completed"
          : "waiting";
    const price = 20 + Math.floor(rng() * 3980);
    const monthIdx = Math.floor(rng() * 12);
